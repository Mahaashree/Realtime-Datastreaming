# ============================================================================
# MQTT Broker Configuration
# ============================================================================
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883

# MQTT Security Configuration (optional)
# Set MQTT_USE_TLS=true to enable TLS encryption
MQTT_USE_TLS=false
MQTT_TLS_INSECURE=false  # Set to true for self-signed certificates (development only)
MQTT_CA_CERTS=  # Path to CA certificate file (e.g., docker/mosquitto/config/certs/ca.crt)
MQTT_CERTFILE=  # Path to client certificate file (optional, for mutual TLS)
MQTT_KEYFILE=  # Path to client private key file (optional, for mutual TLS)

# MQTT Authentication (optional)
MQTT_USERNAME=  # MQTT username (leave empty for anonymous access)
MQTT_PASSWORD=  # MQTT password (leave empty for anonymous access)
MQTT_CLIENT_ID=  # Custom MQTT client ID (optional, defaults to device_{device_id} or mqtt-collector-python)

# ============================================================================
# InfluxDB Configuration
# ============================================================================
INFLUXDB_URL=http://localhost:8086
INFLUXDB_URL_FALLBACK=  # Optional fallback URL (dashboard will try this if primary fails)
INFLUXDB_TOKEN=my-super-secret-auth-token
INFLUXDB_ORG=my-org
INFLUXDB_BUCKET=vehicle-data

# ============================================================================
# Flask Dashboard Configuration
# ============================================================================
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_SECRET_KEY=dev-secret-key-change-in-production  # Change this in production!

# ============================================================================
# Collector Configuration
# ============================================================================
# Worker threads for processing messages (default: 8)
COLLECTOR_WORKER_THREADS=8

# Maximum queue size before messages are dropped (default: 20000)
COLLECTOR_MAX_QUEUE_SIZE=20000

# Batch size for draining messages from queue (default: 50)
BATCH_DRAIN_SIZE=50

# Log file path (default: logs/collector.log)
LOG_FILE=logs/collector.log

# ============================================================================
# Prometheus & Monitoring Configuration
# ============================================================================
# Enable Prometheus metrics export (default: true)
ENABLE_PROMETHEUS=true

# Prometheus metrics server port (default: 9090)
PROMETHEUS_PORT=9090

# Collector stats server port for real-time metrics (default: 9091)
# This provides accurate rolling window latency metrics to the dashboard
STATS_SERVER_PORT=9091

# ============================================================================
# Alert Thresholds (Monitoring)
# ============================================================================
# P95 latency threshold in milliseconds (default: 2000)
ALERT_P95_LATENCY_MS=2000

# P99 latency threshold in milliseconds (default: 5000)
ALERT_P99_LATENCY_MS=5000

# Error rate threshold as percentage (default: 5)
ALERT_ERROR_RATE_PCT=5

# Drop rate threshold as percentage (default: 2)
ALERT_DROP_RATE_PCT=2

# Queue depth threshold (default: 15000)
ALERT_QUEUE_DEPTH=15000

# Minimum throughput threshold in msg/s (default: 50)
ALERT_MIN_THROUGHPUT=50

# ============================================================================
# Device Simulator Configuration
# ============================================================================
# Publish interval in seconds (default: 1.0)
PUBLISH_INTERVAL=1.0

# Directory for offline message queues (default: offline_queues)
OFFLINE_QUEUE_DIR=offline_queues

